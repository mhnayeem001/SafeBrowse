# SafeBrowse X Environment Configuration Example
APP_NAME="SafeBrowse X Security Core"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Server
HOST="0.0.0.0"
PORT=8000

# Database & Cache
DATABASE_URL="sqlite+aiosqlite:///./safebrowse.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://safebrowse:safebrowse_secret_2026@localhost:5432/safebrowse_db"

REDIS_URL="redis://localhost:6379/0"

# Security & Secrets
SECRET_KEY="safebrowse-x-change-this-secret-key-in-production-environments-8837194"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Threat Detection Defaults
DEFAULT_SECURITY_MODE="NORMAL"
BLOCK_RISK_THRESHOLD=75
WARN_RISK_THRESHOLD=40

# Optional External Threat Intelligence Keys
GOOGLE_SAFE_BROWSING_KEY=""
VIRUSTOTAL_API_KEY=""
